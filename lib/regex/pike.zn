package regex;

import core$;
import math$;

// The Pike VM runs all threads of the NFA at once, in priority order, and
// each thread keeps its own group positions, so the first thread to reach
// a match holds the groups of the leftmost-first match.

type _Pike = #struct {
	// The threads for the next position: their instructions, and their
	// slots, `width` slots per thread.
	pcs List<Int>;
	slots List<Int>;
	width Int;
	// The slots of the thread that `add` is following.
	current List<Int>;
	// The round number that marks the instructions the current closure has
	// already visited.
	marks List<Int>;
	round Int;
}
_Pike(width Int, size Int) => init{
	pcs = List(Int);
	slots = List(Int);
	width;
	current = List(width, _none());
	marks = List(size, Int(0));
	round = Int(0);
}

// The context of position `i` (counted from 0): bit 1 for the start of the
// text, bit 2 for the start of a line, bit 4 for a preceding word byte.
Int _contextOf(text String, i Int) {
	if(i == 0) {
		return Int(3);
	}
	b Int = Int(text:byteAt(i));
	ctx Int = Int(0);
	if(b == 10) {
		ctx = ctx + 2;
	}
	if(_isWord(b)) {
		ctx = ctx + 4;
	}
	return ctx;
}

// Adds, after the threads already queued, the threads that instruction
// `pc0` reaches at position `pos` without consuming a byte, with the
// current slots.
Unit add(this _Pike, re Regex, text String, pc0 Int, pos Int) mut {
	ctx Int = _contextOf(text, pos);
	next Int = _none();
	if(pos < text:byteCount()) {
		next = Int(text:byteAt(pos + 1));
	}
	// A stack of pairs: an instruction to follow and 0, or a negated slot
	// number (counted from 1) and the value to restore in that slot once
	// the instructions after the save are done.
	stack List<Int> = List(Int);
	p Int = pc0;
	stack!push(p);
	stack!push(Int(0));
	k Int = Int(1);
	k!to(re._ops:size() * 4 + 4) {
		if(stack:size() == 0) {
			return Unit();
		}
		value Int = stack!remove(stack:size());
		code Int = stack!remove(stack:size());
		if(code < 0) {
			this.current[~code] = value;
		}
		guard(code < 0);
		pc Int = code;
		guard(this.marks[pc] == this.round);
		this.marks[pc] = this.round;
		op Int = re._ops[pc];
		if(op == 0 or op == 1) {
			this.pcs!push(pc);
			this.slots!appendRange(this.current, Int(1), this.width);
		}
		if(op == 2) {
			second Int = re._ys[pc];
			stack!push(second);
			stack!push(Int(0));
			first Int = re._xs[pc];
			stack!push(first);
			stack!push(Int(0));
		}
		if(op == 3) {
			if(_holds(re._xs[pc], ctx, next)) {
				after Int = re._ys[pc];
				stack!push(after);
				stack!push(Int(0));
			}
		}
		if(op == 4) {
			slot Int = re._xs[pc] + 1;
			old Int = this.current[slot];
			stack!push(~slot);
			stack!push(old);
			after Int = re._ys[pc];
			stack!push(after);
			stack!push(Int(0));
			this.current[slot] = pos;
		}
	}
	return Unit();
}

// The slots of the leftmost-first match that starts at position `from`
// (counted from 0) when `anchored` is set, or at or after `from` otherwise.
// Every slot is -1 when there is no match. When `limit` is not -1, the
// search stops at position `limit`, where the match is known to end.
List<Int> _pike(this Regex, text String, from Int, anchored Bool, limit Int) {
	width Int = (this._groups + 1) * 2;
	n Int = text:byteCount();
	vm _Pike = _Pike(width, this._ops:size());
	best List<Int> = List(width, _none());
	found Bool = Bool(false);
	vm.round = vm.round + 1;
	vm!add(this, text, this._entry, from);
	pos Int = from;
	k Int = Int(1);
	k!to(n - from + 2) {
		pcs List<Int> = vm.pcs;
		slots List<Int> = vm.slots;
		if(pcs:size() == 0 and (found or anchored)) {
			return best;
		}
		vm.pcs = List(Int);
		vm.slots = List(Int);
		vm.round = vm.round + 1;
		b Int = _none();
		if(pos < n) {
			b = Int(text:byteAt(pos + 1));
		}
		cut Bool = Bool(false);
		t Int = Int(1);
		t!to(pcs:size()) {
			guard(cut);
			pc Int = pcs[t];
			op Int = this._ops[pc];
			if(op == 0) {
				best = List(Int);
				best!appendRange(slots, (t - 1) * width + 1, width);
				found = Bool(true);
				cut = Bool(true);
			}
			if(op == 1 and b >= 0) {
				if(this._sets[(this._xs[pc] - 1) * 256 + b + 1]) {
					vm.current = List(Int);
					vm.current!appendRange(slots, (t - 1) * width + 1, width);
					vm!add(this, text, this._ys[pc], pos + 1);
				}
			}
		}
		if(pos >= n or (limit >= 0 and pos >= limit)) {
			return best;
		}
		if(~found and ~anchored) {
			vm.current = List(width, _none());
			vm!add(this, text, this._entry, pos + 1);
		}
		pos = pos + 1;
	}
	return best;
}

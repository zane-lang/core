package regex;

import core$;
import math$;

// Regular expressions over bytes, with leftmost-first matching as in Perl,
// PCRE and the Rust regex crate, modelled on Goose's regex (regex.goose in
// Goose's stdlib).
//
// A pattern is parsed into a syntax tree and compiled to a Thompson NFA.
// The NFA is built back to front, starting from its match instruction, so
// an instruction's successors already exist when the instruction is added.
// Subset construction then builds two complete DFAs from the NFA: a forward
// DFA over the pattern with an unanchored, lowest-priority `.*?` before it,
// which finds where the leftmost-first match ends, and a reverse DFA over the
// reversed pattern, which runs back from that end to where the match starts.
// A search then costs one table lookup per byte. Whenever the forward DFA is
// in a start state again, a skip loop passes over the text where no match
// can start. The skip loop either tests two bytes at fixed offsets from the
// start of every match, the two that are rarest by a rough frequency table,
// or looks for a rare byte that every match contains.
//
// An assertion tests the byte before a position and the byte after it. A
// DFA state records what kind of byte came before (the start of the text, a
// newline, a word byte), and the DFA follows its NFA states past an
// assertion only once it reads the next byte. A DFA state is therefore a
// match state when the byte that led to it came right after a match. The end
// of the text is one more column of the transition tables.
//
// The positions of groups come from a Pike VM over the same NFA, run over
// a match that the DFAs found. When a pattern's DFAs would grow past their
// size limit, the Pike VM also finds the matches.

/// Why a pattern does not compile: a message describing the error, and the
/// position of the error in the pattern, as a byte position counted from 1.
type RegexError = struct {
	message String;
	at Int;
}
RegexError(message String, at Int) => init{
	message;
	at;
}

/// The position of a match in the searched text: `start` is the match's
/// first byte, counted from 1 as `byteAt` counts, and `count` is the number
/// of bytes in the match. When a search finds nothing, or a group took no
/// part in a match, `start` is 0.
type Match = struct {
	start Int;
	count Int;
}
Match(start Int, count Int) => init{
	start;
	count;
}

/// Whether this `Match` is a found match rather than the result of a search
/// that found nothing.
Bool found(this Match) => this.start > 0;

/// The position after the match's last byte, counted from 1.
Int end(this Match) => this.start + this.count;

/// The bytes of `text` that the match covers; empty when nothing was found.
String text(this Match, text String) {
	if(this.start <= 0) {
		return String("");
	}
	return _slice(text, this.start - 1, this.start - 1 + this.count);
}

// A `Match` from a start and an end counted from 0; a not-found `Match`
// when `start` is -1.
Match _span(start Int, end Int) {
	if(start < 0) {
		return Match(Int(0), Int(0));
	}
	return Match(start + 1, end - start);
}

/// A match and its groups. Group 0 is the whole match, and group `k` is the
/// `k`th capturing group, numbered in the order of the groups' opening `(`
/// in the pattern. Named groups `(?<name>...)` are counted; non-capturing
/// groups `(?:...)` are not.
type Captures = struct {
	// Each group's start and end, counted from 0; both are -1 for a group
	// that took no part in the match.
	_slots List<Int>;
	_names List<String>;
}
Captures._of(slots List<Int>, names List<String>) => init{
	_slots = slots;
	_names = names;
}

/// Whether there is a match.
Bool found(this Captures) => this._slots[Int(1)] >= 0;

/// The number of groups, including group 0, the whole match.
Int size(this Captures) => this._slots:size() / 2;

/// The match of group number `group`. The result's `start` is 0 when the
/// group took no part in the match, when `group` is larger than the number
/// of groups in the pattern, and for every group when there is no match.
Match group(this Captures, group Int) {
	if(group < 0 or group >= this:size()) {
		return Match(Int(0), Int(0));
	}
	return _span(this._slots[group * 2 + 1], this._slots[group * 2 + 2]);
}

/// The match of the group named `name` by `(?<name>...)`. The result's
/// `start` is 0 in the same cases as for `group`, and also when no group has
/// the name `name`, which includes the empty name.
Match named(this Captures, name String) {
	if(name == "") {
		return Match(Int(0), Int(0));
	}
	i Int = Int(1);
	i!to(this._names:size()) {
		if(this._names[i] == name) {
			return this:group(i);
		}
	}
	return Match(Int(0), Int(0));
}

/// A compiled pattern, made by `compile`.
type Regex = struct {
	_nullable Bool;
	// The class of each byte, at index byte + 1, followed by the class of
	// the end of the text.
	_classes List<I32>;
	_end Int;
	_forward _Table;
	_reverse _Table;
	// The prefix test: every match is at least `least` bytes long, and the
	// match's bytes at offsets `at1` and `at2` are in `set1` and `set2`.
	// The skip method, used while the forward DFA is in a start state: 0
	// for no skipping, 1 for the prefix test, 2 for the inner byte. With the
	// inner byte, every match contains a byte of `inner` right after a
	// leading part whose bytes are never in `inner`, and `before` is the
	// reverse DFA of that leading part.
	_skip Int;
	_inner ByteSet;
	_before _Table;
	_least Int;
	_at1 Int;
	_at2 Int;
	_set1 ByteSet;
	_set2 ByteSet;
	// Whether the Pike VM does the search because the DFAs grew too large.
	_fallback Bool;
	_groups Int;
	_names List<String>;
	// The capturing program, which starts at instruction `entry`, and its
	// byte sets.
	_ops List<Int>;
	_xs List<Int>;
	_ys List<Int>;
	_sets List<Bool>;
	_entry Int;
}
Regex._built(nullable Bool, classes List<I32>, end Int, forward _Table, reverse _Table, skip Int, inner ByteSet, before _Table, least Int, at1 Int, at2 Int, set1 ByteSet, set2 ByteSet, fallback Bool, groups Int, names List<String>, ops List<Int>, xs List<Int>, ys List<Int>, sets List<Bool>, entry Int) => init{
	_nullable = nullable;
	_classes = classes;
	_end = end;
	_forward = forward;
	_reverse = reverse;
	_skip = skip;
	_inner = inner;
	_before = before;
	_least = least;
	_at1 = at1;
	_at2 = at2;
	_set1 = set1;
	_set2 = set2;
	_fallback = fallback;
	_groups = groups;
	_names = names;
	_ops = ops;
	_xs = xs;
	_ys = ys;
	_sets = sets;
	_entry = entry;
}

/// The number of groups in the pattern, not counting group 0, the whole
/// match.
Int groupCount(this Regex) => this._groups;

// --- searching -------------------------------------------------------------------

// The context of position `i` (counted from 0) for DFA `d`: the context of
// the byte before position `i`, or the context of the start of the text.
Int _contextAt(d _Table, text String, i Int) {
	if(i == 0) {
		return d.startCtx;
	}
	return Int(d.contexts[Int(text:byteAt(i)) + 1]);
}

// The first position at or after `i` (counted from 0) where the prefix test
// allows a match to start; the length of the text when there is none.
Int _skipPrefix(this Regex, text String, i Int) {
	n Int = text:byteCount();
	fits Int = n - this._least + 1;
	if(i >= fits) {
		return n;
	}
	p Int = text:findPair(i + this._at1 + 1, fits - i, this._set1, this._at2 - this._at1, this._set2) - 1;
	if(p < 0) {
		return n;
	}
	return p - this._at1;
}

// The first position at or after `i` where the inner-byte test allows a
// match to start. The position is the start of the leading part before an
// inner byte, found by running the leading part's reverse DFA back from the
// inner byte, but no further back than `i` or the previous inner byte.
Int _skipInner(this Regex, text String, i Int) {
	n Int = text:byteCount();
	low Int = i;
	q Int = i;
	k Int = Int(1);
	k!to(n + 1) {
		if(q >= n) {
			return n;
		}
		f Int = text:findAny(q + 1, n - q, this._inner) - 1;
		if(f < 0) {
			return n;
		}
		s Int = _scanBack(this._before, this._classes, this._end, text, low, f);
		if(s >= 0) {
			return s;
		}
		q = f + 1;
		low = q;
	}
	return n;
}

Int _resume(this Regex, text String, i Int) {
	if(this._skip == 1) {
		return this:_skipPrefix(text, i);
	}
	if(this._skip == 2) {
		return this:_skipInner(text, i);
	}
	return i;
}

// The end (counted from 0, just past the last byte) of the leftmost-first
// match that starts at or after `at`, or -1 when there is no match. With
// `earliest`, returns the end of the first match that the forward DFA
// reaches; that end is useful only to learn whether there is a match.
Int _findEnd(this Regex, text String, at Int, earliest Bool) {
	n Int = text:byteCount();
	special Int = this._forward.special;
	matchEnd Int = this._forward.matchEnd;
	last Int = _none();
	i Int = this:_resume(text, at);
	if(i >= n and this._skip > 0) {
		return last;
	}
	s Int = Int(this._forward.starts[_contextAt(this._forward, text, i) + 1]);
	k Int = Int(1);
	k!to(n + 1) {
		if(i >= n) {
			s = Int(this._forward.trans[s + this._end + 1]);
			if(s ~= 0) {
				last = n;
			}
			return last;
		}
		s = Int(this._forward.trans[s + Int(this._classes[Int(text:byteAt(i + 1)) + 1]) + 1]);
		i = i + 1;
		if(s < special) {
			kind Bool = if(s >= matchEnd) {
				i = this:_resume(text, i);
				if(i >= n) {
					return last;
				}
				s = Int(this._forward.starts[_contextAt(this._forward, text, i) + 1]);
			}
			kind!elif(s == 0) {
				return last;
			}
			kind:else() {
				last = i - 1;
				if(earliest) {
					return last;
				}
			}
		}
	}
	return last;
}

// Runs the reverse DFA `d` back from `end`, no further than `low`, and
// returns the position where it last matched, which is the leftmost start
// of a match of `d`'s pattern that ends at `end`; -1 when there is none.
Int _scanBack(d _Table, classes List<I32>, endClass Int, text String, low Int, end Int) {
	matchEnd Int = d.matchEnd;
	ctx Int = d.startCtx;
	if(end < text:byteCount()) {
		ctx = Int(d.contexts[Int(text:byteAt(end + 1)) + 1]);
	}
	s Int = Int(d.starts[ctx + 1]);
	first Int = _none();
	i Int = end;
	k Int = Int(1);
	k!to(end - low) {
		s = Int(d.trans[s + Int(classes[Int(text:byteAt(i)) + 1]) + 1]);
		if(s < matchEnd) {
			if(s == 0) {
				return first;
			}
			first = i;
		}
		i = i - 1;
	}
	c Int = endClass;
	if(low > 0) {
		c = Int(classes[Int(text:byteAt(low)) + 1]);
	}
	s = Int(d.trans[s + c + 1]);
	if(s ~= 0 and s < matchEnd) {
		first = low;
	}
	return first;
}

// The start and end of the leftmost-first match that starts at or after
// `at` (counted from 0); both are -1 when there is no match.
List<Int> _search(this Regex, text String, at Int) {
	out List<Int> = List(Int);
	fallback Bool = this._fallback;
	if(fallback) {
		slots List<Int> = this:_pike(text, at, Bool(false), _none());
		s Int = slots[Int(1)];
		e Int = slots[Int(2)];
		out!push(s);
		out!push(e);
		return out;
	}
	e Int = this:_findEnd(text, at, Bool(false));
	s Int = _none();
	if(e >= 0) {
		s = _scanBack(this._reverse, this._classes, this._end, text, at, e);
	}
	out!push(s);
	out!push(e);
	return out;
}

/// Whether the pattern matches anywhere in `text`.
Bool isMatch(this Regex, text String) {
	fallback Bool = this._fallback;
	if(fallback) {
		return this:_search(text, Int(0))[Int(1)] >= 0;
	}
	return this:_findEnd(text, Int(0), Bool(true)) >= 0;
}

/// The leftmost-first match in `text`.
Match find(this Regex, text String) => this:findFrom(text, Int(1));

/// The leftmost-first match that starts at or after byte `from` (counted
/// from 1). Assertions still test the bytes before `from`.
Match findFrom(this Regex, text String, from Int) {
	at Int = from - 1;
	if(at < 0) {
		at = Int(0);
	}
	if(at > text:byteCount()) {
		return Match(Int(0), Int(0));
	}
	span List<Int> = this:_search(text, at);
	return _span(span[Int(1)], span[Int(2)]);
}

// Every match, left to right, as the Rust regex crate's find_iter yields
// them, as a start and an end (counted from 0) for each match. No two
// matches overlap, and no empty match starts where the previous match
// ended.
List<Int> _spans(this Regex, text String) {
	out List<Int> = List(Int);
	n Int = text:byteCount();
	at Int = Int(0);
	lastEnd Int = _none();
	k Int = Int(1);
	fallback Bool = this._fallback;
	k!to(n + 2) {
		if(at > n) {
			return out;
		}
		// The match from `at`; when that match is empty and starts right at
		// the previous match's end, the match from the next byte instead.
		// The DFAs are run here directly, so no list is allocated for each
		// match.
		from Int = at;
		s Int = _none();
		e Int = _none();
		done Bool = Bool(false);
		j Int = Int(1);
		j!to(Int(2)) {
			guard(done);
			found Bool = if(fallback) {
				span List<Int> = this:_search(text, from);
				s = span[Int(1)];
				e = span[Int(2)];
			}
			found:else() {
				e = this:_findEnd(text, from, Bool(false));
				s = _none();
				if(e >= 0) {
					s = _scanBack(this._reverse, this._classes, this._end, text, from, e);
				}
			}
			done = Bool(true);
			if(e >= 0 and s == e and e == lastEnd) {
				done = from == n or j == 2;
				if(from == n) {
					e = _none();
				}
				from = from + 1;
			}
		}
		if(e < 0 or (s == e and e == lastEnd)) {
			return out;
		}
		out!push(s);
		out!push(e);
		at = e;
		lastEnd = e;
	}
	return out;
}

/// Every match, left to right. No two matches overlap, and no empty match
/// starts right where the previous match ended.
List<Match> findAll(this Regex, text String) {
	spans List<Int> = this:_spans(text);
	out List<Match> = List(Match);
	i Int = Int(1);
	i!to(spans:size() / 2) {
		out!push(_span(spans[i * 2 - 1], spans[i * 2]));
	}
	return out;
}

/// The number of matches that `findAll` finds. When the pattern cannot
/// match the empty string, each match is counted from its end alone, which
/// saves running the reverse DFA to find each match's start.
Int count(this Regex, text String) {
	if(this._nullable or this._fallback) {
		return this:_spans(text):size() / 2;
	}
	total Int = Int(0);
	at Int = Int(0);
	k Int = Int(1);
	k!to(text:byteCount() + 1) {
		e Int = this:_findEnd(text, at, Bool(false));
		if(e < 0) {
			return total;
		}
		total = total + 1;
		at = e;
	}
	return total;
}

// The groups of the match from `s` to `e` (counted from 0); every slot is
// -1 when `s` is -1.
Captures _groupsOf(this Regex, text String, s Int, e Int) {
	slots List<Int> = List((this._groups + 1) * 2, _none());
	if(s >= 0) {
		groups Bool = this._groups > 0;
		known Bool = if(groups) {
			slots = this:_pike(text, s, Bool(true), e);
		}
		known:else() {
			slots[Int(1)] = s;
			slots[Int(2)] = e;
		}
	}
	return Captures._of(slots, this._names);
}

/// The leftmost-first match in `text` and its groups.
Captures captures(this Regex, text String) => this:capturesFrom(text, Int(1));

/// The leftmost-first match that starts at or after byte `from` (counted
/// from 1), and its groups.
Captures capturesFrom(this Regex, text String, from Int) {
	at Int = from - 1;
	if(at < 0) {
		at = Int(0);
	}
	if(at > text:byteCount()) {
		return this:_groupsOf(text, _none(), _none());
	}
	span List<Int> = this:_search(text, at);
	return this:_groupsOf(text, span[Int(1)], span[Int(2)]);
}

/// Every match, as `findAll` finds them, each with its groups.
List<Captures> capturesAll(this Regex, text String) {
	spans List<Int> = this:_spans(text);
	out List<Captures> = List(Captures);
	i Int = Int(1);
	i!to(spans:size() / 2) {
		out!push(this:_groupsOf(text, spans[i * 2 - 1], spans[i * 2]));
	}
	return out;
}

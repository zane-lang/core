package regex;

import core$;
import math$;

// The index of a DFA's states by their keys, used while the DFA is built: a
// hash table with open addressing over a power-of-two number of slots. Every
// key is appended to one shared byte list, and each slot holds the key's
// range in that list. Keys are hashed and compared a word at a time.

type _Slot = struct {
	start I32;
	length I32;
	value I32;
}
_Slot(start I32, length I32, value I32) => init{
	start;
	length;
	value;
}

type _Index = struct {
	slots List<_Slot>;
	entries Int;
	shift Int;
}

// The exponent of the smallest power of two that is at least `capacity`,
// from 1 to 62: a table with that many slots holds `capacity` keys.
Int _tableBits(capacity Int) {
	bits Int = Int(1);
	bits!to(Int(62)) {
		if(shiftLeft(Int(1), bits) >= capacity) {
			return bits;
		}
	}
	return Int(62);
}

_Index(capacity Int) => init{
	slots = List(shiftLeft(Int(1), _tableBits(capacity)), _Slot(I32(0), I32(0), I32(0)));
	entries = Int(0);
	shift = Int(64) - _tableBits(capacity);
}

// The slot that holds the key made of the `count` bytes of `from` starting
// at `start`, where every stored key is a range of `keys`. When no slot holds
// that key, returns the empty slot where the key belongs, or 0 when the
// table is full. An empty slot has the start 0.
Int slotIn(this _Index, keys List<U8>, from List<U8>, start Int, count Int) {
	capacity Int = this.slots:size();
	index Int = shiftRightLogical(from:hashRange(start, count) * (Int(0) - Int(7046029254386353131)), this.shift) + 1;
	probe Int = Int(1);
	probe!to(capacity) {
		slot _Slot = this.slots[index];
		if(Int(slot.start) == 0) {
			return index;
		}
		// `and` evaluates both operands, so the bytes are compared only for
		// a key of the same length.
		if(Int(slot.length) == count) {
			if(keys:sameRange(Int(slot.start), from, start, count)) {
				return index;
			}
		}
		index = index + 1;
		if(index > capacity) {
			index = Int(1);
		}
	}
	return Int(0);
}

// The value of the key made of the `count` bytes of `from` starting at
// `start`, or -1 when no such key is stored.
Int findIn(this _Index, keys List<U8>, from List<U8>, start Int, count Int) {
	index Int = this:slotIn(keys, from, start, count);
	if(index == 0) {
		return Int(0) - Int(1);
	}
	slot _Slot = this.slots[index];
	if(Int(slot.start) == 0) {
		return Int(0) - Int(1);
	}
	return Int(slot.value);
}

// Doubles the table once it is two thirds full, and places each key again.
Unit grow(this _Index, keys List<U8>) mut {
	old List<_Slot> = this.slots;
	this.slots = List(old:size() * 2, _Slot(I32(0), I32(0), I32(0)));
	this.shift = this.shift - 1;
	i Int = Int(1);
	i!to(old:size()) {
		slot _Slot = old[i];
		if(Int(slot.start) ~= 0) {
			this.slots[this:slotIn(keys, keys, Int(slot.start), Int(slot.length))] = slot;
		}
	}
	return Unit();
}

// Stores the `count` bytes of `keys` starting at `start` as a key with the
// value `value`.
Unit put(this _Index, keys List<U8>, start Int, count Int, value Int) mut {
	if((this.entries + 1) * 3 > this.slots:size() * 2) {
		this!grow(keys);
	}
	index Int = this:slotIn(keys, keys, start, count);
	if(index > 0) {
		if(Int(this.slots[index].start) == 0) {
			this.entries = this.entries + 1;
		}
		this.slots[index] = _Slot(I32.wrap(start), I32.wrap(count), I32.wrap(value));
	}
	return Unit();
}

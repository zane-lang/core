package core;

// The math functions (math.md §3). Each is a function, not a method: it
// computes a result from its inputs (functions.md §3.6).


// Int
/// Each bit set where it is set in both operands.
Int bitAnd(left Int, right Int) => Int(@math$bitAnd(left._value, right._value))
/// Each bit set where it is set in either operand.
Int bitOr(left Int, right Int) => Int(@math$bitOr(left._value, right._value))
/// Each bit set where it is set in exactly one operand.
Int bitXor(left Int, right Int) => Int(@math$bitXor(left._value, right._value))
/// Every bit flipped.
Int bitNot(value Int) => Int(@math$bitNot(value._value))
/// The bits moved `count` places up, zeros filling in. The count is taken
/// modulo 64.
Int shiftLeft(value Int, count Int) => Int(@math$shiftLeft(value._value, count._value))
/// The bits moved `count` places down, copies of the sign bit filling in.
/// The count is taken modulo 64.
Int shiftRight(value Int, count Int) => Int(@math$shiftRight(value._value, count._value))
/// The bits moved `count` places down, zeros filling in. The count is taken
/// modulo 64.
Int shiftRightLogical(value Int, count Int) => Int(@math$shiftRightLogical(value._value, count._value))
/// The bits moved `count` places up, those moved out filling in below.
Int rotateLeft(value Int, count Int) => Int(@math$rotateLeft(value._value, count._value))
/// The bits moved `count` places down, those moved out filling in above.
Int rotateRight(value Int, count Int) => Int(@math$rotateRight(value._value, count._value))
/// The number of set bits.
Int popCount(value Int) => Int(@math$popCount(value._value))
/// The number of zero bits above the highest set bit; 64 for zero.
Int leadingZeros(value Int) => Int(@math$leadingZeros(value._value))
/// The number of zero bits below the lowest set bit; 64 for zero.
Int trailingZeros(value Int) => Int(@math$trailingZeros(value._value))
/// The magnitude. The most negative `Int` gives itself back.
Int abs(value Int) => Int(@math$abs(value._value))
Int min(left Int, right Int) => Int(@math$min(left._value, right._value))
Int max(left Int, right Int) => Int(@math$max(left._value, right._value))


// Float: exact
/// The square root, correctly rounded; a NaN below zero.
Float sqrt(value Float) => Float(@math$sqrt(value._value))
Float abs(value Float) => Float(@math$abs(value._value))
Float floor(value Float) => Float(@math$floor(value._value))
Float ceil(value Float) => Float(@math$ceil(value._value))
/// Rounded toward zero to an integer.
Float trunc(value Float) => Float(@math$trunc(value._value))
/// Rounded to the nearest integer, a tie going to the even one.
Float roundEven(value Float) => Float(@math$roundEven(value._value))
/// `left * right + addend`, rounded once.
Float fma(left Float, right Float, addend Float) => Float(@math$fma(left._value, right._value, addend._value))
/// `magnitude` with the sign of `sign`.
Float copySign(magnitude Float, sign Float) => Float(@math$copySign(magnitude._value, sign._value))
/// The lesser operand, or a NaN when either is one.
Float min(left Float, right Float) => Float(@math$min(left._value, right._value))
/// The greater operand, or a NaN when either is one.
Float max(left Float, right Float) => Float(@math$max(left._value, right._value))


// Float: approximate, the platform's C math library (math.md §2.6)
Float cbrt(value Float) => Float(@math$cbrt(value._value))
/// Of an angle in radians.
Float sin(value Float) => Float(@math$sin(value._value))
Float cos(value Float) => Float(@math$cos(value._value))
Float tan(value Float) => Float(@math$tan(value._value))
/// In radians.
Float asin(value Float) => Float(@math$asin(value._value))
Float acos(value Float) => Float(@math$acos(value._value))
Float atan(value Float) => Float(@math$atan(value._value))
/// The angle in radians, from -π to π, of the point (x, y).
Float atan2(y Float, x Float) => Float(@math$atan2(y._value, x._value))
Float exp(value Float) => Float(@math$exp(value._value))
/// The natural logarithm.
Float log(value Float) => Float(@math$log(value._value))
Float pow(base Float, exponent Float) => Float(@math$pow(base._value, exponent._value))
/// `sqrt(x * x + y * y)`, without overflow or underflow in between.
Float hypot(x Float, y Float) => Float(@math$hypot(x._value, y._value))

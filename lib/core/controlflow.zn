package core;

Bool if(condition Bool, body @concepts$Block) {
	@controlflow$branch(condition, body);
	return condition;
}

Unit elif(this Bool, condition Bool, body @concepts$Block) mut {
	@controlflow$branch(~this * condition, body);
	this = this + condition;
	return Unit();
}

Unit else(this Bool, body @concepts$Block) {
	@controlflow$branch(~this, body);
	return Unit();
}

Unit guard(condition Bool) {
	@controlflow$branch(condition, {
		@controlflow$exitFromCall();
	});
	return Unit();
}

Unit do(body @concepts$Block) {
	@controlflow$branch(true, body);
	return Unit();
}

Unit to(this Int, end Int, body @concepts$Block) mut {
	@controlflow$repeat(end - this + Int(1), {
		@controlflow$branch(true, body);
		this = this + Int(1);
	});
	return Unit();
}

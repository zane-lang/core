package core;

type Runtime = #struct {
	_runtime &@runtime$Runtime;
}

Runtime(runtime &@runtime$Runtime) => init{
	_runtime = runtime;
}

/// The arguments the program was started with, without the program's own name.
List<String> arguments(this Runtime) {
	raw @primitives$List<@primitives$String> = this._runtime:arguments();
	args List<String> = List(String);
	i Int = Int(1);
	i!to(Int(raw:size())) {
		args!push(String(raw[i._value]));
	}
	return args;
}

/// Sets the thread pool's size to `count` threads. When `count` is below one,
/// aborts and leaves the thread pool unchanged.
Unit?Unit setThreads(this Runtime, count Int) mut {
	this._runtime!setThreads(count._value) ? e {
		abort Unit();
	}
	return Unit();
}

/// Sets the thread pool's size to the number of threads the hardware runs at
/// once.
Unit setThreadsAuto(this Runtime) mut {
	this._runtime!setThreadsAuto();
	return Unit();
}

package core;

// Unit
type Unit = struct {
	_value @primitives$Unit;
}
Unit() => init{
	_value = @primitives$Unit();
}


// Bool
type Bool = struct {
	_value @primitives$Bool;
}
implicit Bool(v @primitives$Bool) => init{
	_value = v;
}
implicit @primitives$Bool(v Bool) => v._value;

Bool ~(v Bool) => Bool(@operators$not(v._value));
Bool and(left Bool, right Bool) => Bool(@operators$conjoin(left._value, right._value));
Bool or(left Bool, right Bool) => Bool(@operators$disjoin(left._value, right._value));
Bool ==(left Bool, right Bool) => Bool(@operators$equal(left._value, right._value));

/// Overloads with `true` or `false` on either side. Operands are never
/// converted, and a `true` or `false` literal is a primitive boolean, so the
/// literal can be an operand of these operators only through overloads that
/// take the primitive type.
Bool and(left Bool, right @primitives$Bool) => left and Bool(right);
Bool and(left @primitives$Bool, right Bool) => Bool(left) and right;
Bool or(left Bool, right @primitives$Bool) => left or Bool(right);
Bool or(left @primitives$Bool, right Bool) => Bool(left) or right;
Bool ==(left Bool, right @primitives$Bool) => left == Bool(right);
Bool ==(left @primitives$Bool, right Bool) => Bool(left) == right;


// Int
type Int = struct {
	_value @primitives$I64;
}
implicit Int(v @primitives$I64) => init{
	_value = v;
}
implicit Int(v @concepts$Int) => Int(@primitives$I64(v));
implicit @primitives$I64(v Int) => v._value;
/// `v` rounded toward zero, held to the range of an `Int`.
Int.truncate(v Float) => Int(@primitives$I64.truncate(v._value));
Int.truncate(v F32) => Int(@primitives$I64.truncate(v._value));

Int ~(v Int) => Int(@operators$negate(v._value));
Int +(left Int, right Int) => Int(@operators$add(left._value, right._value));
Int *(left Int, right Int) => Int(@operators$multiply(left._value, right._value));
Int /(left Int, right Int) => Int(@operators$divide(left._value, right._value));
Bool ==(left Int, right Int) => Bool(@operators$equal(left._value, right._value));
Bool <(left Int, right Int) => Bool(@operators$lessThan(left._value, right._value));

/// Overloads with a literal operand on either side. Operands are never
/// converted, so a literal can be an operand of an operator only through an
/// overload that takes the literal's type.
Int +(left Int, right @concepts$Int) => left + Int(right);
Int +(left @concepts$Int, right Int) => Int(left) + right;
Int *(left Int, right @concepts$Int) => left * Int(right);
Int *(left @concepts$Int, right Int) => Int(left) * right;
Int /(left Int, right @concepts$Int) => left / Int(right);
Int /(left @concepts$Int, right Int) => Int(left) / right;
Bool ==(left Int, right @concepts$Int) => left == Int(right);
Bool ==(left @concepts$Int, right Int) => Int(left) == right;
Bool <(left Int, right @concepts$Int) => left < Int(right);
Bool <(left @concepts$Int, right Int) => Int(left) < right;


// Float
type Float = struct {
	_value @primitives$F64;
}
Float(v @primitives$F64) => init{
	_value = v;
}
Float(v @primitives$I64) => Float(@primitives$F64.round(v));
Float(v Int) => Float(v._value);
/// Takes an integer literal as the argument: `Float(3)`. A program uses `I32`
/// and `F32` only when it asks for them, so a bare integer literal is read as
/// an `Int` (generics.md §5.4).
Float(v @concepts$Int) => Float(Int(v));
implicit Float(v @concepts$Float) => Float(@primitives$F64(v));
implicit @primitives$F64(v Float) => v._value;

Float ~(v Float) => Float(@operators$negate(v._value));
Float +(left Float, right Float) => Float(@operators$add(left._value, right._value));
Float *(left Float, right Float) => Float(@operators$multiply(left._value, right._value));
Float /(left Float, right Float) => Float(@operators$divide(left._value, right._value));
Bool ==(left Float, right Float) => Bool(@operators$equal(left._value, right._value));
Bool <(left Float, right Float) => Bool(@operators$lessThan(left._value, right._value));

/// Overloads with a literal operand on either side, as for `Int`.
Float +(left Float, right @concepts$Float) => left + Float(right);
Float +(left @concepts$Float, right Float) => Float(left) + right;
Float *(left Float, right @concepts$Float) => left * Float(right);
Float *(left @concepts$Float, right Float) => Float(left) * right;
Float /(left Float, right @concepts$Float) => left / Float(right);
Float /(left @concepts$Float, right Float) => Float(left) / right;
Bool ==(left Float, right @concepts$Float) => left == Float(right);
Bool ==(left @concepts$Float, right Float) => Float(left) == right;
Bool <(left Float, right @concepts$Float) => left < Float(right);
Bool <(left @concepts$Float, right Float) => Float(left) < right;


// I32
/// A 32-bit integer, for compact storage of bounded data: a `List<I32>` takes
/// 4 bytes per element. `Int` stays the default for counts, indices and loops;
/// convert with `Int(x)` where an `Int` is needed.
type I32 = struct {
	_value @primitives$I32;
}
I32(v @primitives$I32) => init{
	_value = v;
}
implicit I32(v @concepts$Int) => I32(@primitives$I32(v));
implicit @primitives$I32(v I32) => v._value;
/// The low 32 bits of `v`, read as a signed integer.
I32.wrap(v Int) => I32(@primitives$I32.wrap(v._value));
/// `v` rounded toward zero, held to the range of an `I32`.
I32.truncate(v F32) => I32(@primitives$I32.truncate(v._value));
I32.truncate(v Float) => I32(@primitives$I32.truncate(v._value));
/// A float literal passed as the argument is read as a `Float`, the same way
/// as for `Float(3)`.
I32.truncate(v @concepts$Float) => I32.truncate(Float(v));
/// Exact: every `I32` is an `Int`.
Int(v I32) => Int(@primitives$I64(v._value));
/// Exact: every `U8` is an `I32` in 0..255.
I32(v U8) => I32(@primitives$I32(v._value));

I32 ~(v I32) => I32(@operators$negate(v._value));
I32 +(left I32, right I32) => I32(@operators$add(left._value, right._value));
I32 *(left I32, right I32) => I32(@operators$multiply(left._value, right._value));
I32 /(left I32, right I32) => I32(@operators$divide(left._value, right._value));
Bool ==(left I32, right I32) => Bool(@operators$equal(left._value, right._value));
Bool <(left I32, right I32) => Bool(@operators$lessThan(left._value, right._value));

/// Overloads with a literal operand on either side, as for `Int`.
I32 +(left I32, right @concepts$Int) => left + I32(right);
I32 +(left @concepts$Int, right I32) => I32(left) + right;
I32 *(left I32, right @concepts$Int) => left * I32(right);
I32 *(left @concepts$Int, right I32) => I32(left) * right;
I32 /(left I32, right @concepts$Int) => left / I32(right);
I32 /(left @concepts$Int, right I32) => I32(left) / right;
Bool ==(left I32, right @concepts$Int) => left == I32(right);
Bool ==(left @concepts$Int, right I32) => I32(left) == right;
Bool <(left I32, right @concepts$Int) => left < I32(right);
Bool <(left @concepts$Int, right I32) => I32(left) < right;


// U8
/// An unsigned byte, for compact storage of bytes: a `List<U8>` takes 1
/// byte per element. `U8` has no arithmetic of its own: convert a byte with
/// `Int(b)` to compute with it, and store an `Int` as a byte with `U8.wrap(i)`.
type U8 = struct {
	_value @primitives$U8;
}
U8(v @primitives$U8) => init{
	_value = v;
}
implicit U8(v @concepts$Int) => U8(@primitives$U8(v));
implicit @primitives$U8(v U8) => v._value;
/// The low 8 bits of `v`, read as an unsigned byte.
U8.wrap(v Int) => U8(@primitives$U8.wrap(v._value));
U8.wrap(v I32) => U8(@primitives$U8.wrap(v._value));
/// Exact: every `U8` is an `Int` in 0..255.
Int(v U8) => Int(@primitives$I64(v._value));
Bool ==(left U8, right U8) => Bool(@operators$equal(left._value, right._value));
Bool <(left U8, right U8) => Bool(@operators$lessThan(left._value, right._value));
Bool ==(left U8, right @concepts$Int) => left == U8(right);
Bool ==(left @concepts$Int, right U8) => U8(left) == right;
Bool <(left U8, right @concepts$Int) => left < U8(right);
Bool <(left @concepts$Int, right U8) => U8(left) < right;


// F32
/// A 32-bit float, for compact storage of bounded data. `Float` stays the
/// default for general arithmetic.
type F32 = struct {
	_value @primitives$F32;
}
F32(v @primitives$F32) => init{
	_value = v;
}
implicit F32(v @concepts$Float) => F32(@primitives$F32(v));
implicit @primitives$F32(v F32) => v._value;
/// The `F32` nearest `v`, a tie going to the even one.
F32.round(v Float) => F32(@primitives$F32.round(v._value));
F32.round(v I32) => F32(@primitives$F32.round(v._value));
F32.round(v Int) => F32(@primitives$F32.round(v._value));
/// A literal passed as the argument is read as an `Int` or a `Float`, the same
/// way as for `Float(3)`.
F32.round(v @concepts$Int) => F32.round(Int(v));
F32.round(v @concepts$Float) => F32.round(Float(v));
/// Exact: every `F32` is a `Float`.
Float(v F32) => Float(@primitives$F64(v._value));
/// Exact: every `I32` is a `Float`.
Float(v I32) => Float(@primitives$F64(v._value));

F32 ~(v F32) => F32(@operators$negate(v._value));
F32 +(left F32, right F32) => F32(@operators$add(left._value, right._value));
F32 *(left F32, right F32) => F32(@operators$multiply(left._value, right._value));
F32 /(left F32, right F32) => F32(@operators$divide(left._value, right._value));
Bool ==(left F32, right F32) => Bool(@operators$equal(left._value, right._value));
Bool <(left F32, right F32) => Bool(@operators$lessThan(left._value, right._value));

/// Overloads with a literal operand on either side, as for `Int`.
F32 +(left F32, right @concepts$Float) => left + F32(right);
F32 +(left @concepts$Float, right F32) => F32(left) + right;
F32 *(left F32, right @concepts$Float) => left * F32(right);
F32 *(left @concepts$Float, right F32) => F32(left) * right;
F32 /(left F32, right @concepts$Float) => left / F32(right);
F32 /(left @concepts$Float, right F32) => F32(left) / right;
Bool ==(left F32, right @concepts$Float) => left == F32(right);
Bool ==(left @concepts$Float, right F32) => F32(left) == right;
Bool <(left F32, right @concepts$Float) => left < F32(right);
Bool <(left @concepts$Float, right F32) => F32(left) < right;


// Hex
/// The digits of `this` in base 16, lowercase, with no leading zeros and a
/// `-` before a negative number: `Int(255):hex()` is `ff`.
String hex(this Int) => _hex(this, Int(1));
String hex(this I32) => _hex(Int(this), Int(1));
/// Always two digits, as a byte is written: `U8(10):hex()` is `0a`.
String hex(this U8) => _hex(Int(this), Int(2));

/// The base-16 digits of `value`, at least `width` of them, after a `-` when
/// it is negative.
String _hex(value Int, width Int) {
	// Worked on the value made negative, since every `Int` has a negative of
	// the same size, including the smallest, and division rounds toward
	// zero: the digits come lowest first.
	n Int = value;
	if(0 < value) {
		n = ~value;
	}
	digits List<U8> = List(U8);
	top Int = Int(1);
	i Int = Int(1);
	i!to(Int(16)) {
		quotient Int = n / 16;
		digit Int = quotient * 16 - n;
		digits!push(_hexDigit(digit));
		if(0 < digit) {
			top = i;
		}
		n = quotient;
	}
	if(top < width) {
		top = width;
	}
	text List<U8> = List(U8);
	if(value < 0) {
		text!push(U8(45));
	}
	j Int = Int(1);
	j!to(top) {
		text!push(digits[top - j + 1]);
	}
	return String(text);
}
/// The byte that writes a digit from 0 to 15: `0`-`9`, then `a`-`f`.
U8 _hexDigit(digit Int) {
	if(digit < 10) {
		return U8.wrap(digit + 48);
	}
	return U8.wrap(digit + 87);
}


// String
type String = struct {
	_value @primitives$String;
}
String(v @primitives$String) => init {
	_value = v;
}
String(v Int) => String(@primitives$String(v._value));
String(v Float) => String(@primitives$String(v._value));
String(v I32) => String(@primitives$String(v._value));
String(v F32) => String(@primitives$String(v._value));
/// Converts the byte to its decimal number, `0` to `255`: the same text that
/// `String(Int(v))` gives.
String(v U8) => String(Int(v));
/// Converts the value to the text `true` or `false`, the spelling of the
/// `Bool` literals.
String(v Bool) {
	if(v) {
		return String("true");
	}
	return String("false");
}
/// A numeric literal passed as the argument is read as an `Int` or a `Float`,
/// the same way as for `Float(3)`.
String(v @concepts$Int) => String(Int(v));
String(v @concepts$Float) => String(Float(v));
/// A string literal is read as text with its escapes applied: `\n`, `\t`, `\r`,
/// `\0` and `\\` are escapes in the literal's own text, never in a value
/// interpolated into the literal (types.md §2.7).
implicit String(v @concepts$String) => String(@primitives$String.escaped(v));
implicit @primitives$String(v String) => v._value;

/// The string's length in bytes, and the byte at `index`, counted from 1;
/// an index outside the string stops the program.
Int byteCount(this String) => Int(this._value:byteCount());
U8 byteAt(this String, index Int) => U8(this._value:byteAt(index._value));
String +(left String, right String) => String(@operators$concat(left._value, right._value));
Bool ==(left String, right String) => Bool(@operators$equal(left._value, right._value));

/// Overloads with a literal operand on either side, as for `Int`.
String +(left String, right @concepts$String) => left + String(right);
String +(left @concepts$String, right String) => String(left) + right;
Bool ==(left String, right @concepts$String) => left == String(right);
Bool ==(left @concepts$String, right String) => String(left) == right;

/// The integer written in the text: digits, as in an integer literal, with an
/// optional `-`. Aborts when the text is not an integer, or is an integer too
/// large for an `Int`.
Int?Unit parseInt(this String) {
	value @primitives$I64 = this._value:parseI64() ? e {
		abort Unit();
	}
	return Int(value);
}

/// The number written in the text: an integer or a float literal with an
/// optional `-`. Aborts when the text is not a number, or is a number too
/// large for a `Float`.
Float?Unit parseFloat(this String) {
	value @primitives$F64 = this._value:parseF64() ? e {
		abort Unit();
	}
	return Float(value);
}

/// `parseFloat` on the `count` bytes from byte `start`, counted from 1 as
/// `byteAt` counts, without copying them out first.
Float?Unit parseFloat(this String, start Int, count Int) {
	value @primitives$F64 = this._value:parseF64At(start._value, count._value) ? e {
		abort Unit();
	}
	return Float(value);
}

/// A set of bytes, made from 256 flags by `byteSet`. `findAny` and `findPair`
/// search a string for the bytes in a set.
type ByteSet = struct {
	_value @primitives$List<@primitives$U8>;
}
ByteSet(v @primitives$List<@primitives$U8>) => init{
	_value = v;
}

/// The set of the bytes whose flags are `true`: byte `b`'s flag is the list's
/// element `b + 1`. The list holds 256 flags.
ByteSet byteSet(this List<Bool>) => ByteSet(this._value:byteSet());

/// The first of the `count` positions from `from`, counted from 1 as
/// `byteAt` counts, whose byte is in `first` and whose byte `gap` positions
/// later is in `second`, or 0 when there is none.
Int findPair(this String, from Int, count Int, first ByteSet, gap Int, second ByteSet) =>
	Int(this._value:findPair(from._value, count._value, first._value, gap._value, second._value));

/// The first of the `count` positions from `from`, counted from 1, whose
/// byte is in `set`, or 0 when there is none.
Int findAny(this String, from Int, count Int, set ByteSet) =>
	Int(this._value:findAny(from._value, count._value, set._value));

/// A hash of the string's bytes, the same for equal strings within one
/// run of the program and not specified beyond that.
Int hashBytes(this String) => Int(this._value:hashBytes());

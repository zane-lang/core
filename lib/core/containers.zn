package core;

// Array
type Array<T Type, n @concepts$Int> = struct {
	_value @primitives$Array<T, n>;
}
Array<T, n>(values @concepts$Array<T Type, n @concepts$Int>) => init{
	_value = @primitives$Array(values);
}

Int size(this Array<T Type, n @concepts$Int>) => Int(n);
(this Array<T Type, n @concepts$Int>)[index Int] => this._value[index._value];


// ArrayRef
type ArrayRef<T Type, n @concepts$Int> = #struct {
	_value @primitives$ArrayRef<T, n>;
}
/// Builds an `ArrayRef` from an array literal by copying each element in. The
/// elements are values, or `&` values for an `ArrayRef<&T, n>` (generics.md
/// §8.4).
ArrayRef<T, n>(values @concepts$Array<T Type, n @concepts$Int>) => init{
	_value = @primitives$ArrayRef(values);
}
/// Builds an `ArrayRef` of owners from an array literal by taking each
/// element: an owner of a reference type is moved in, and a value is copied
/// in.
ArrayRef<T, n>.roaming(values @concepts$Array<^T Type, n @concepts$Int>) => init{
	_value = @primitives$ArrayRef.roaming(values);
}
/// Builds an `ArrayRef` of references from an array literal, one reference
/// per element: a settled owner mints a new reference, and an `&` value is
/// copied in.
ArrayRef<&T, n>.refs(values @concepts$Array<&T Type, n @concepts$Int>) => init{
	_value = @primitives$ArrayRef.refs(values);
}
/// Builds an `ArrayRef` of `n` elements by calling `make` once per position,
/// in order, with the position counted from 1:
/// `ArrayRef.fill(3, Int(i Int) => i * i)` holds 1, 4 and 9.
ArrayRef<T, n>.fill(n @concepts$Int, make ^T Type[Int]) => init{
	_value = @primitives$ArrayRef.fill(n, make);
}

Int size(this ArrayRef<T Type, n @concepts$Int>) => Int(n);
(this ArrayRef<T Type, n @concepts$Int>)[index Int] => this._value[index._value];


// List
type List<T Type> = struct {
	_value @primitives$List<T>;
}
List<T>(T Type) => init{
	_value = @primitives$List(T);
}
/// A list of `n` copies of `value`, allocated in one block; an empty list
/// when `n` is below one.
List<T>(n Int, value T Type) {
	values @primitives$List<T> = @primitives$List(T);
	@controlflow$repeat(n, {
		copy T = value;
		values!push(copy);
	});
	return init{ _value = values; }
}

Int size(this List<T Type>) => Int(this._value:size());
Unit push(this List<T Type>, value T) mut {
	this._value!push(value);
	return Unit();
}
/// Takes the element at `index` out and shifts the later elements down,
/// keeping their order.
T remove(this List<T Type>, index Int) mut => this._value!remove(index._value);
/// Takes the element at `index` out and moves the last element into its
/// place. This moves only one element, whatever the index, but does not keep
/// the order.
T swapRemove(this List<T Type>, index Int) mut => this._value!swapRemove(index._value);
(this List<T Type>)[index Int] => this._value[index._value];
/// Copies `count` elements of `from`, starting at element `start`, onto the
/// end of the list in a single copy. Only for elements that own no blocks.
Unit appendRange(this List<T Type>, from List<T>, start Int, count Int) mut {
	this._value!appendRange(from._value, start._value, count._value);
	return Unit();
}
/// Copies `count` elements of `from`, starting at element `start`, over this
/// list's elements starting at element `at`, in a single copy. Both ranges lie
/// within their lists. For elements that own no blocks.
Unit copyRange(this List<T Type>, at Int, from List<T>, start Int, count Int) mut {
	this._value!copyRange(at._value, from._value, start._value, count._value);
	return Unit();
}
/// Sorts this list of `I32` positions into the `Int` list `keys`, counted
/// from 1, in place, in ascending order of the key at each position.
/// Positions with equal keys keep their order. A position outside `keys`
/// stops the program.
Unit sortBy(this List<T Type>, keys List<K Type>) mut {
	this._value!sortBy(keys._value);
	return Unit();
}
/// Sorts the elements in place, in ascending order. For lists of integers:
/// `I32`, `Int` and `U8`.
Unit sort(this List<T Type>) mut {
	this._value!sort();
	return Unit();
}
/// Like `appendRange`, but copies the list's own elements.
Unit appendOwn(this List<T Type>, start Int, count Int) mut {
	this._value!appendOwn(start._value, count._value);
	return Unit();
}
/// Whether `count` elements from `start` are the same as `count` of
/// `other` from `otherStart`, as one comparison of their bytes. For lists
/// of integers.
Bool sameRange(this List<T Type>, start Int, other List<T>, otherStart Int, count Int) =>
	Int(this._value:sameRange(start._value, other._value, otherStart._value, count._value)) == Int(1);
/// A hash of `count` elements from `start`, read a word at a time; equal
/// ranges have equal hashes within one run of the program. For lists of integers.
Int hashRange(this List<T Type>, start Int, count Int) => Int(this._value:hashRange(start._value, count._value));


// ListRef
type ListRef<T Type> = #struct {
	_value @primitives$ListRef<T>;
}
ListRef<T>(T Type) => init{
	_value = @primitives$ListRef(T);
}

Int size(this ListRef<T Type>) => Int(this._value:size());
Unit push(this ListRef<T Type>, value ^T) mut {
	this._value!push(value);
	return Unit();
}
/// Moves the element at `index` out and shifts the later elements down,
/// keeping their order.
^T remove(this ListRef<T Type>, index Int) mut => this._value!remove(index._value);
/// Moves the element at `index` out and moves the last element into its
/// place. This moves only one element, whatever the index, but does not keep
/// the order.
^T swapRemove(this ListRef<T Type>, index Int) mut => this._value!swapRemove(index._value);
(this ListRef<T Type>)[index Int] => this._value[index._value];

/// A String holding the bytes of `bytes`.
String(bytes List<U8>) => String(bytes._value:text());

package core;

// Array
type Array<T Type, n @concepts$Int> = struct {
	_value @primitives$Array<T, n>;
}
Array<T, n>(values @concepts$Array<T Type, n @concepts$Int>) => init{
	_value = @primitives$Array(values);
}

Int size(this Array<T Type, n @concepts$Int>) => Int(n);
(this Array<T Type, n @concepts$Int>)[index Int] => this._value[index._value];


// ArrayRef
type ArrayRef<T Type, n @concepts$Int> = #struct {
	_value @primitives$ArrayRef<T, n>;
}
ArrayRef<T, n>(values @concepts$Array<T Type, n @concepts$Int>) => init{
	_value = @primitives$ArrayRef(values);
}

Int size(this ArrayRef<T Type, n @concepts$Int>) => Int(n);
(this ArrayRef<T Type, n @concepts$Int>)[index Int] => this._value[index._value];


// List
type List<T Type> = struct {
	_value @primitives$List<T>;
}
List<T>(T Type) => init{
	_value = @primitives$List(T);
}

Int size(this List<T Type>) => Int(this._value:size());
Unit push(this List<T Type>, value T) mut {
	this._value!push(value);
	return Unit();
}
/// Takes the element at `index` out and shifts the later ones down, keeping
/// their order.
T remove(this List<T Type>, index Int) mut => this._value!remove(index._value);
/// Takes the element at `index` out and moves the last one into its place,
/// which moves one element whatever the index, but does not keep the order.
T swapRemove(this List<T Type>, index Int) mut => this._value!swapRemove(index._value);
(this List<T Type>)[index Int] => this._value[index._value];


// ListRef
type ListRef<T Type> = #struct {
	_value @primitives$ListRef<T>;
}
ListRef<T>(T Type) => init{
	_value = @primitives$ListRef(T);
}

Int size(this ListRef<T Type>) => Int(this._value:size());
Unit push(this ListRef<T Type>, value ^T) mut {
	this._value!push(value);
	return Unit();
}
/// Moves the element at `index` out and shifts the later ones down, keeping
/// their order.
^T remove(this ListRef<T Type>, index Int) mut => this._value!remove(index._value);
/// Moves the element at `index` out and moves the last one into its place,
/// which moves one element whatever the index, but does not keep the order.
^T swapRemove(this ListRef<T Type>, index Int) mut => this._value!swapRemove(index._value);
(this ListRef<T Type>)[index Int] => this._value[index._value];

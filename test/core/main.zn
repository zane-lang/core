package test;

import core$;

Unit check(this Console, ok Bool) mut {
	ran Bool = if(ok) {
		this!print("yes");
	}
	ran:else() {
		this!print("no");
	}
	return Unit();
}

Int firstAbove(values List<Int>, limit Int) {
	i Int = Int(1);
	i!to(values:size()) {
		if(limit < values[i]) {
			return i;
		}
	}
	return Int(0);
}

Unit printUnlessStopped(this Console, stop Bool) mut {
	do() {
		guard(stop);
		this!print("yes");
	}
	return Unit();
}

/// Within a tolerance of the true value: an approximate function's last
/// digit is the platform's (math.md §2.6).
Bool near(value Float, expected Float) => abs(value - expected) < 0.000000000001

Unit main() {
	console Console(@program$console);

	// Int, Float and their operators.
	res Float = Float(3.0) * 3.0;
	console!check(res == 9.0);
	console!check(Int(7) - Int(2) == 5);
	console!check(Int(2) < 3 '* Int(3) > 2);
	console!check(Int(3) <= 3 '* Int(4) >= 3 '* Int(4) ~= 3);
	console!check(Int(7) / 2 == 3);
	console!check(Float(Int(7)) / Float(Int(2)) == 3.5);
	console!check(Float(Int(2)) == 2.0);
	console!check(Int.truncate(Float(2.75)) == 2);
	console!check(~Float(1.5) < 0.0);

	// Bool algebra.
	yes Bool = Bool(true);
	no Bool = Bool(false);
	console!check(yes * ~no);
	console!check(no + yes);
	console!check(~(yes == no));
	console!check(yes ~= no);

	// String.
	greeting String = String("hello");
	console!check(greeting + " world" == "hello world");
	console!check(String(Int(42)) == "42");
	console!check(String(Float(2.5)) == "2.5");

	// Numbers read from text.
	console!check((String("42"):parseInt() ?? Int(0)) == 42);
	console!check((String("-7"):parseInt() ?? Int(0)) == ~Int(7));
	console!check((String("4x"):parseInt() ?? Int(1)) == 1);
	console!check((String("2.5"):parseInt() ?? Int(1)) == 1);
	console!check((String("99999999999999999999"):parseInt() ?? Int(1)) == 1);
	console!check((String("2.5"):parseFloat() ?? Float(0.0)) == 2.5);
	console!check((String("-3"):parseFloat() ?? Float(0.0)) == ~Float(3.0));
	console!check((String(" 1"):parseFloat() ?? Float(1.5)) == 1.5);

	// Math functions.
	console!check(bitAnd(Int(12), Int(10)) == 8);
	console!check(bitOr(Int(12), Int(10)) == 14);
	console!check(bitXor(Int(12), Int(10)) == 6);
	console!check(bitNot(Int(0)) == ~Int(1));
	console!check(shiftLeft(Int(1), Int(65)) == 2);
	console!check(shiftRight(~Int(16), Int(2)) == ~Int(4));
	console!check(shiftRightLogical(~Int(1), Int(60)) == 15);
	console!check(rotateRight(rotateLeft(Int(6), Int(3)), Int(3)) == 6);
	console!check(popCount(Int(255)) == 8);
	console!check(leadingZeros(Int(0)) == 64);
	console!check(trailingZeros(Int(8)) == 3);
	console!check(abs(~Int(5)) == 5);
	console!check(min(Int(3), ~Int(2)) == ~Int(2));
	console!check(max(Int(3), ~Int(2)) == 3);
	console!check(sqrt(Float(16.0)) == 4.0);
	console!check(abs(~Float(2.5)) == 2.5);
	console!check(floor(~Float(1.5)) == ~Float(2.0));
	console!check(ceil(Float(1.25)) == 2.0);
	console!check(trunc(~Float(1.75)) == ~Float(1.0));
	console!check(roundEven(Float(2.5)) == 2.0);
	console!check(fma(Float(2.0), Float(3.0), Float(1.0)) == 7.0);
	console!check(copySign(Float(2.0), ~Float(1.0)) == ~Float(2.0));
	console!check(min(Float(1.0), Float(2.0)) == 1.0);
	console!check(max(Float(1.0), Float(2.0)) == 2.0);
	console!check(near(sin(Float(0.5)), 0.479425538604203));
	console!check(near(cos(Float(0.5)), 0.8775825618903728));
	console!check(near(tan(Float(0.5)), 0.5463024898437905));
	console!check(near(asin(Float(0.5)), 0.5235987755982989));
	console!check(near(acos(Float(0.5)), 1.0471975511965979));
	console!check(near(atan(Float(1.0)), 0.7853981633974483));
	console!check(near(atan2(Float(1.0), ~Float(1.0)), 2.356194490192345));
	console!check(near(exp(Float(1.0)), 2.718281828459045));
	console!check(near(log(Float(10.0)), 2.302585092994046));
	console!check(near(pow(Float(2.0), Float(10.0)), 1024.0));
	console!check(near(cbrt(~Float(27.0)), ~Float(3.0)));
	console!check(near(hypot(Float(3.0), Float(4.0)), 5.0));

	// The program's arguments, as `String`s.
	runtime Runtime(@program$runtime);
	args List<String> = runtime:arguments();
	raw @primitives$List<@primitives$String> = @program$runtime:arguments();
	console!check(args:size() == Int(raw:size()));
	same Bool = Bool(true);
	k Int = Int(1);
	k!to(args:size()) {
		same = same * (args[k] == String(raw[k]));
	}
	console!check(same);

	// The thread pool, sized through the runtime.
	refused Bool = Bool(false);
	runtime!setThreads(Int(0)) ? e {
		refused = Bool(true);
		resolve Unit();
	}
	console!check(refused);
	accepted Bool = Bool(true);
	runtime!setThreads(Int(2)) ? e {
		accepted = Bool(false);
		resolve Unit();
	}
	console!check(accepted);
	runtime!setThreadsAuto();

	// Control flow.
	chain Bool = if(Int(1) == 2) {
		console!print("no");
	}
	chain!elif(Int(1) == 1) {
		console!print("yes");
	}
	chain!elif(true) {
		console!print("no");
	}
	chain:else() {
		console!print("no");
	}
	reached Bool = Bool(false);
	do() {
		reached = Bool(true);
	}
	console!check(reached);
	count Int = Int(0);
	i Int = Int(1);
	i!to(Int(10)) {
		count = count + i;
	}
	console!check(count == 55);
	console!printUnlessStopped(Bool(false));
	console!printUnlessStopped(Bool(true));

	// Array.
	numbers Array<Int, 4> = Array([Int(1), Int(2), ~Int(5), Int(4)]);
	console!check(numbers:size() == 4);
	console!check(numbers[Int(2)] == 2);
	numbers[Int(2)] = Int(20);
	console!check(numbers[Int(2)] == 20);

	// ArrayRef.
	refs ArrayRef<Int, 3> = ArrayRef([Int(4), Int(5), Int(6)]);
	console!check(refs:size() == 3);
	refs[Int(3)] = Int(60);
	console!check(refs[Int(1)] + refs[Int(3)] == 64);

	// List.
	list List<Int> = List(Int);
	console!check(list:size() == 0);
	j Int = Int(1);
	j!to(Int(5)) {
		list!push(j * j);
	}
	console!check(list:size() == 5);
	console!check(list[Int(5)] == 25);
	list[Int(5)] = Int(0);
	console!check(firstAbove(list, Int(5)) == 3);
	words List<String> = List(String);
	words!push("a");
	words!push("b");
	console!check(words[Int(1)] + words[Int(2)] == "ab");

	// Removing from a List: in order, and by moving the last one in.
	console!check(list!remove(Int(2)) == 4);
	console!check(list:size() == 4);
	console!check(list[Int(2)] == 9);
	console!check(list!swapRemove(Int(1)) == 1);
	console!check(list[Int(1)] == 0);
	console!check(list:size() == 3);
	words!push("c");
	removed String = words!remove(Int(1));
	console!check(removed + words[Int(1)] + words[Int(2)] == "abc");
	console!check(words!swapRemove(Int(1)) == "b");
	console!check(words:size() == 1);
	console!check(words[Int(1)] == "c");
	return Unit();
}

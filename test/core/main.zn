package test;

import core$;

Unit check(this Console, ok Bool) mut {
	ran Bool = if(ok) {
		this!print("yes");
	}
	ran:else() {
		this!print("no");
	}
	return Unit();
}

Int firstAbove(values List<Int>, limit Int) {
	i Int = Int(1);
	i!to(values:size()) {
		if(limit < values[i]) {
			return i;
		}
	}
	return Int(0);
}

/// A value type that holds a list, which is legal since a `List` is a value.
type Shelf = struct {
	labels List<String>;
}
Shelf(labels List<String>) => init{ labels; }

/// An owner, which a `ListRef` holds and a `List` cannot.
type Jar = #struct {
	beans Int;
}
Jar(beans Int) => init{ beans; }

Unit printUnlessStopped(this Console, stop Bool) mut {
	do() {
		guard(stop);
		this!print("yes");
	}
	return Unit();
}

Unit main() {
	console Console(@program$console);

	// Int, Float and their operators.
	res Float = Float(3.0) * 3.0;
	console!check(res == 9.0);
	console!check(Int(7) - Int(2) == 5);
	console!check(Int(2) < 3 and Int(3) > 2);
	console!check(Int(3) <= 3 and Int(4) >= 3 and Int(4) ~= 3);
	console!check(Int(7) / 2 == 3);
	console!check(Float(Int(7)) / Float(Int(2)) == 3.5);
	console!check(Float(Int(2)) == 2.0);
	console!check(Int.truncate(Float(2.75)) == 2);
	console!check(~Float(1.5) < 0.0);

	// Bool algebra.
	yes Bool = Bool(true);
	no Bool = Bool(false);
	console!check(yes and ~no);
	console!check(no or yes);
	console!check(~(yes and no));
	console!check(~(no or no));
	console!check(Int(1) < 2 or Int(2) < 1 and Int(3) < 1);
	console!check(yes and true and ~(no or false) and true or no);
	console!check(yes == true and false == no and ~(true == no));

	// A literal operand on either side.
	console!check(1 < Int(2) and 3 * Int(2) == 6 and 7 - Int(2) == 5);
	console!check(1.5 < Float(2.0) and 3.0 / Float(2.0) == 1.5);
	console!check(Int(7) - 2 == 5 and Float(7.0) - 2.5 == 4.5);
	console!check(Int(~3) + 5 == 2 and ~1.5 < Float(0.0));
	console!check(~(yes == no));
	console!check(yes ~= no);

	// String.
	greeting String = String("hello");
	console!check(greeting + " world" == "hello world");
	console!check("say " + greeting == "say hello");
	console!check(String(Int(42)) == "42");
	console!check(String(Float(2.5)) == "2.5");

	// A literal: a value interpolated into it is copied in, and its text
	// escapes are read in its own text, never in that value.
	console!check(String("say \%greeting!") == "say hello!");
	console!check(String("\n") == String(@primitives$String.escaped("\n")));
	console!check(String("\n") ~= String(@primitives$String("\n")));
	written String = String(@primitives$String("a\nb"));
	console!check(String("[\%written]") == String(@primitives$String("[a\nb]")));

	// Numbers read from text.
	console!check((String("42"):parseInt() ?? Int(0)) == 42);
	console!check((String("-7"):parseInt() ?? Int(0)) == ~Int(7));
	console!check((String("4x"):parseInt() ?? Int(1)) == 1);
	console!check((String("2.5"):parseInt() ?? Int(1)) == 1);
	console!check((String("99999999999999999999"):parseInt() ?? Int(1)) == 1);
	console!check((String("2.5"):parseFloat() ?? Float(0.0)) == 2.5);
	console!check((String("-3"):parseFloat() ?? Float(0.0)) == ~Float(3.0));
	console!check((String(" 1"):parseFloat() ?? Float(1.5)) == 1.5);

	// The program's arguments, as `String`s.
	runtime Runtime(@program$runtime);
	args List<String> = runtime:arguments();
	raw @primitives$List<@primitives$String> = @program$runtime:arguments();
	console!check(args:size() == Int(raw:size()));
	same Bool = Bool(true);
	k Int = Int(1);
	k!to(args:size()) {
		same = same and args[k] == String(raw[k]);
	}
	console!check(same);

	// The thread pool, sized through the runtime.
	refused Bool = Bool(false);
	runtime!setThreads(Int(0)) ? e {
		refused = Bool(true);
		resolve Unit();
	}
	console!check(refused);
	accepted Bool = Bool(true);
	runtime!setThreads(Int(2)) ? e {
		accepted = Bool(false);
		resolve Unit();
	}
	console!check(accepted);
	runtime!setThreadsAuto();

	// Control flow.
	chain Bool = if(Int(1) == 2) {
		console!print("no");
	}
	chain!elif(Int(1) == 1) {
		console!print("yes");
	}
	chain!elif(true) {
		console!print("no");
	}
	chain:else() {
		console!print("no");
	}
	reached Bool = Bool(false);
	do() {
		reached = Bool(true);
	}
	console!check(reached);
	count Int = Int(0);
	i Int = Int(1);
	i!to(Int(10)) {
		count = count + i;
	}
	console!check(count == 55);
	console!printUnlessStopped(Bool(false));
	console!printUnlessStopped(Bool(true));

	// Array.
	numbers Array<Int, 4> = Array([Int(1), Int(2), ~Int(5), Int(4)]);
	console!check(numbers:size() == 4);
	console!check(numbers[Int(2)] == 2);
	numbers[Int(2)] = Int(20);
	console!check(numbers[Int(2)] == 20);

	// ArrayRef.
	refs ArrayRef<Int, 3> = ArrayRef([Int(4), Int(5), Int(6)]);
	console!check(refs:size() == 3);
	refs[Int(3)] = Int(60);
	console!check(refs[Int(1)] + refs[Int(3)] == 64);

	// List.
	list List<Int> = List(Int);
	console!check(list:size() == 0);
	j Int = Int(1);
	j!to(Int(5)) {
		list!push(j * j);
	}
	console!check(list:size() == 5);
	console!check(list[Int(5)] == 25);
	list[Int(5)] = Int(0);
	console!check(firstAbove(list, Int(5)) == 3);
	words List<String> = List(String);
	words!push("a");
	words!push("b");
	console!check(words[Int(1)] + words[Int(2)] == "ab");

	// Removing from a List: in order, and by moving the last one in.
	console!check(list!remove(Int(2)) == 4);
	console!check(list:size() == 4);
	console!check(list[Int(2)] == 9);
	console!check(list!swapRemove(Int(1)) == 1);
	console!check(list[Int(1)] == 0);
	console!check(list:size() == 3);
	words!push("c");
	removed String = words!remove(Int(1));
	console!check(removed + words[Int(1)] + words[Int(2)] == "abc");
	console!check(words!swapRemove(Int(1)) == "b");
	console!check(words:size() == 1);
	console!check(words[Int(1)] == "c");

	// A List is a value: a copy owns elements of its own.
	copied List<String> = words;
	copied!push("d");
	copied[Int(1)] = String("e");
	console!check(words:size() == 1);
	console!check(words[Int(1)] == "c");
	console!check(copied[Int(1)] + copied[Int(2)] == "ed");
	shelf Shelf(copied);
	shelf.labels!push("f");
	console!check(copied:size() == 2);
	console!check(shelf.labels:size() == 3);

	// ListRef: a list of owners.
	jars ListRef<Jar> = ListRef(Jar);
	jars!push(Jar(Int(1)));
	jars!push(Jar(Int(2)));
	jars!push(Jar(Int(3)));
	console!check(jars:size() == 3);
	jars[Int(2)].beans = Int(20);
	console!check(jars[Int(2)].beans == 20);
	moved ^Jar = jars!remove(Int(1));
	console!check(moved.beans == 1);
	console!check(jars[Int(1)].beans == 20);
	console!check(jars!swapRemove(Int(1)).beans == 20);
	console!check(jars:size() == 1);
	console!check(jars[Int(1)].beans == 3);
	// I32 and F32: narrow scalars for compact storage.
	big I32 = I32(2147483647);
	console!check(big + 1 < 0);
	console!check(big + 1 == ~big - 1);
	console!check(~(~big - 1) == ~big - 1);
	console!check(big * 2 == ~2);
	console!check(I32(7) + I32(5) == 12 and I32(7) * I32(5) == 35);
	console!check(I32(7) / I32(2) == 3 and ~I32(7) / I32(2) == ~3);
	console!check(I32(7) / I32(0) == 0);
	console!check(~(~big - 1) / ~1 == ~big - 1);
	console!check(I32(2) < I32(3) and ~(I32(3) < I32(3)) and I32(3) >= 3);
	console!check(1 + I32(2) == 3 and 3 * I32(2) == 6 and 7 / I32(2) == 3);
	console!check(I32(2) + 1 == 3 and I32(2) * 3 == 6 and I32(7) / 2 == 3);
	console!check(1 < I32(2) and I32(2) < 3 and 2 == I32(2) and I32(2) == 2);
	console!check(Int(I32(7)) == 7 and Int(~I32(7)) == ~Int(7));
	console!check(Int(big) + 1 == 2147483648);
	console!check(I32.wrap(Int(5)) == 5 and I32.wrap(~Int(5)) == ~5);
	console!check(I32.wrap(Int(2147483648)) == ~big - 1);
	console!check(I32.wrap(Int(4294967296) + 3) == 3);
	console!check(I32.wrap(Int(4294967295)) == ~1);
	console!check(I32.truncate(Float(2.75)) == 2 and I32.truncate(~Float(2.75)) == ~2);
	console!check(I32.truncate(Float(1000000000000.0)) == big);
	console!check(I32.truncate(F32.round(Float(3.9))) == 3);
	console!check(String(I32(42)) == "42" and String(~I32(7)) == "-7");
	console!check(String(big) == "2147483647");

	// U8 (experiment): a byte that widens without its sign.
	byte U8 = U8(200);
	console!check(Int(byte) == 200 and Int(U8(255)) + 1 == 256);
	console!check(U8.wrap(Int(256) + 7) == 7 and Int(U8.wrap(~Int(1))) == 255);
	console!check(byte == 200 and U8(3) < U8(200) and ~(byte < U8(3)));
	bytes List<U8> = List(U8);
	b Int = Int(0);
	b!to(Int(299)) {
		bytes!push(U8.wrap(b));
	}
	console!check(bytes:size() == 300 and Int(bytes[Int(256)]) == 255 and Int(bytes[Int(258)]) == 1);
	word String = String("héllo");
	console!check(word:byteCount() == 6 and Int(word:byteAt(Int(1))) == 104 and Int(word:byteAt(Int(2))) == 195);
	abc List<U8> = List(U8);
	abc!push(U8(97));
	abc!push(U8(98));
	abc!push(U8(99));
	console!check(String(abc) == "abc" and String(List(U8)) == "");

	fl F32 = F32(1.5);
	console!check(fl + 2.0 == 3.5 and 2.0 + fl == 3.5);
	console!check(fl * F32(2.0) == 3.0 and fl * 2.0 == 3.0 and 2.0 * fl == 3.0);
	console!check(fl / F32(2.0) == 0.75 and fl / 2.0 == 0.75 and 3.0 / fl == 2.0);
	console!check(~fl < 0.0 and fl < 2.0 and 1.0 < fl and ~(fl < fl));
	console!check(fl == 1.5 and 1.5 == fl and fl ~= 2.0);
	console!check(~fl == ~F32(1.5));
	console!check(Float(fl) == 1.5 and Float(~fl) == ~Float(1.5));
	console!check(Float(I32(7)) == 7.0 and Float(~big) == ~Float(2147483647.0));
	console!check(F32.round(Float(2.5)) == 2.5);
	console!check(Float(F32.round(Float(0.1))) ~= 0.1);
	console!check(Float(F32.round(Float(0.1))) == 0.10000000149011612);
	console!check(F32.round(Float(16777217.0)) == 16777216.0);
	console!check(F32.round(I32(16777217)) == 16777216.0);
	console!check(F32.round(Int(3)) == 3.0);
	console!check(String(F32(2.5)) == "2.5");
	console!check(String(~F32(0.5)) == "-0.5");
	counts List<I32> = List(I32);
	counts!push(I32(7));
	counts!push(big);
	console!check(counts[Int(1)] == 7 and counts[Int(2)] == big);

	// A call whose arguments are all literals takes Int or Float.
	console!check(Float(139968) == 139968.0 and Float(2.5) == 2.5);
	console!check(String(5) == "5" and String(2.5) == "2.5");
	console!check(Int(3) == 3 and I32(3) == 3);

	return Unit();
}

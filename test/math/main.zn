package test;

import core$;
import math$;

Unit check(this Console, ok Bool) mut {
	ran Bool = if(ok) {
		this!print("yes");
	}
	ran:else() {
		this!print("no");
	}
	return Unit();
}

/// Within a tolerance of the true value: an approximate function's last
/// digit is the platform's (math.md §2.6).
Bool near(value Float, expected Float) => abs(value - expected) < 0.000000000001;

Unit main() {
	console Console(@program$console);

	console!check(bitAnd(Int(12), Int(10)) == 8);
	console!check(bitOr(Int(12), Int(10)) == 14);
	console!check(bitXor(Int(12), Int(10)) == 6);
	console!check(bitNot(Int(0)) == ~Int(1));
	console!check(shiftLeft(Int(1), Int(65)) == 2);
	console!check(shiftRight(~Int(16), Int(2)) == ~Int(4));
	console!check(shiftRightLogical(~Int(1), Int(60)) == 15);
	console!check(rotateRight(rotateLeft(Int(6), Int(3)), Int(3)) == 6);
	console!check(popCount(Int(255)) == 8);
	console!check(leadingZeros(Int(0)) == 64);
	console!check(trailingZeros(Int(8)) == 3);
	console!check(abs(~Int(5)) == 5);
	console!check(min(Int(3), ~Int(2)) == ~Int(2));
	console!check(max(Int(3), ~Int(2)) == 3);
	console!check(sqrt(Float(16.0)) == 4.0);
	console!check(abs(~Float(2.5)) == 2.5);
	console!check(floor(~Float(1.5)) == ~Float(2.0));
	console!check(ceil(Float(1.25)) == 2.0);
	console!check(trunc(~Float(1.75)) == ~Float(1.0));
	console!check(roundEven(Float(2.5)) == 2.0);
	console!check(fma(Float(2.0), Float(3.0), Float(1.0)) == 7.0);
	console!check(copySign(Float(2.0), ~Float(1.0)) == ~Float(2.0));
	console!check(min(Float(1.0), Float(2.0)) == 1.0);
	console!check(max(Float(1.0), Float(2.0)) == 2.0);
	console!check(near(sin(Float(0.5)), 0.479425538604203));
	console!check(near(cos(Float(0.5)), 0.8775825618903728));
	console!check(near(tan(Float(0.5)), 0.5463024898437905));
	console!check(near(asin(Float(0.5)), 0.5235987755982989));
	console!check(near(acos(Float(0.5)), 1.0471975511965979));
	console!check(near(atan(Float(1.0)), 0.7853981633974483));
	console!check(near(atan2(Float(1.0), ~Float(1.0)), 2.356194490192345));
	console!check(near(exp(Float(1.0)), 2.718281828459045));
	console!check(near(log(Float(10.0)), 2.302585092994046));
	console!check(near(pow(Float(2.0), Float(10.0)), 1024.0));
	console!check(near(cbrt(~Float(27.0)), ~Float(3.0)));
	console!check(near(hypot(Float(3.0), Float(4.0)), 5.0));

	// I32 and F32.
	console!check(bitAnd(I32(12), I32(10)) == 8 and bitOr(I32(12), I32(10)) == 14);
	console!check(bitXor(I32(12), I32(10)) == 6 and bitNot(I32(0)) == ~1);
	console!check(shiftLeft(I32(1), I32(33)) == 2);
	console!check(shiftLeft(I32(1), I32(31)) == ~I32(2147483647) - 1);
	console!check(shiftRight(~I32(16), I32(2)) == ~4);
	console!check(shiftRightLogical(~I32(1), I32(28)) == 15);
	console!check(rotateRight(rotateLeft(I32(6), I32(3)), I32(3)) == 6);
	console!check(popCount(I32(255)) == 8 and popCount(bitNot(I32(1))) == 31);
	console!check(leadingZeros(I32(0)) == 32 and trailingZeros(I32(0)) == 32);
	console!check(trailingZeros(I32(8)) == 3);
	console!check(abs(~I32(5)) == 5 and min(I32(3), ~I32(2)) == ~2 and max(I32(3), ~I32(2)) == 3);
	console!check(sqrt(F32(16.0)) == 4.0 and abs(~F32(2.5)) == 2.5);
	console!check(floor(~F32(1.5)) == ~F32(2.0) and ceil(F32(1.25)) == 2.0);
	console!check(trunc(~F32(1.75)) == ~F32(1.0) and roundEven(F32(2.5)) == 2.0);
	console!check(fma(F32(2.0), F32(3.0), F32(1.0)) == 7.0);
	console!check(copySign(F32(2.0), ~F32(1.0)) == ~F32(2.0));
	console!check(min(F32(1.0), F32(2.0)) == 1.0 and max(F32(1.0), F32(2.0)) == 2.0);
	console!check(abs(sin(F32(0.5)) - F32(0.4794255)) < 0.00001);
	console!check(abs(pow(F32(2.0), F32(10.0)) - F32(1024.0)) < 0.001);
	console!check(abs(hypot(F32(3.0), F32(4.0)) - F32(5.0)) < 0.00001);

	// A call whose arguments are all literals takes Int or Float.
	console!check(bitAnd(12, 10) == 8 and bitOr(12, 10) == 14 and bitXor(12, 10) == 6);
	console!check(bitNot(0) == ~Int(1));
	console!check(shiftLeft(1, 65) == 2 and shiftRight(~Int(16), 2) == ~Int(4));
	console!check(shiftRightLogical(~Int(1), 60) == 15);
	console!check(rotateRight(rotateLeft(6, 3), 3) == 6);
	console!check(popCount(255) == 8 and leadingZeros(0) == 64 and trailingZeros(8) == 3);
	console!check(abs(3) == 3 and min(3, 2) == 2 and max(3, 2) == 3);
	console!check(sqrt(16.0) == 4.0 and abs(2.5) == 2.5);
	console!check(floor(1.5) == 1.0 and ceil(1.25) == 2.0 and trunc(2.75) == 2.0);
	console!check(roundEven(2.5) == 2.0 and roundEven(3.5) == 4.0);
	console!check(fma(2.0, 3.0, 1.0) == 7.0 and copySign(2.0, 1.0) == 2.0);
	console!check(min(1.5, 2.5) == 1.5 and max(1.5, 2.5) == 2.5);
	console!check(near(cbrt(27.0), 3.0) and near(sin(0.0), 0.0) and near(cos(0.0), 1.0));
	console!check(near(tan(0.0), 0.0) and near(asin(0.0), 0.0) and near(acos(1.0), 0.0));
	console!check(near(atan(0.0), 0.0) and near(atan2(0.0, 1.0), 0.0));
	console!check(near(exp(0.0), 1.0) and near(log(1.0), 0.0) and near(pow(2.0, 3.0), 8.0));
	console!check(near(hypot(3.0, 4.0), 5.0));
	console!check(I32.truncate(2.75) == 2 and F32.round(3) == 3.0 and F32.round(2.5) == 2.5);
	console!check(String(5) == "5" and String(2.5) == "2.5");
	console!check(Float(139968) == 139968.0);

	// A typed operand keeps the call on its own width.
	x Int = Int(12);
	y Float = Float(16.0);
	console!check(bitAnd(x, 10) == 8 and bitAnd(10, x) == 8 and max(x, 3) == 12);
	console!check(sqrt(y) == 4.0 and min(y, 2.5) == 2.5 and max(2.5, y) == 16.0);
	console!check(bitAnd(I32(12), 10) == 8 and min(F32(1.5), 2.5) == 1.5);

	return Unit();
}
